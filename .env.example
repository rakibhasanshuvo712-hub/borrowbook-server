# ============================================================
# BookNook backend (Express) — copy to .env and fill in.
#
#   cp .env.example .env
#
# Only these two values are needed locally. Vercel production
# also needs JWT_SECRET set in the dashboard.
# ============================================================

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string

# Frontend origin (must match the client app's URL)
CLIENT_URL=http://localhost:3000
