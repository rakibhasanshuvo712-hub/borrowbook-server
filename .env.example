# ============================================================
# BookNook backend (Express) — copy to .env and fill in.
#
#   cp .env.example .env
#
# These are server-side secrets. The frontend has its own .env with
# only browser-visible values.
# ============================================================

# ---------- Database ----------
MONGO_URI=your_mongodb_connection_string

# ---------- Server ----------
PORT=5000

# ---------- Authentication ----------
# Signs the JWT sent as "Authorization: Bearer <token>" on private routes.
JWT_SECRET=your_jwt_secret

# Signs Better Auth's session cookies (any long random string).
BETTER_AUTH_SECRET=your_better_auth_secret

# The Next.js dev server's origin — used for CORS and Better Auth
# trustedOrigins. Must match the frontend's port.
CLIENT_URL=http://localhost:3000

# Better Auth's own public URL (the backend's origin).
BETTER_AUTH_URL=http://localhost:5000
